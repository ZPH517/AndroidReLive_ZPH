{
  "name": "androidrelive-zph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "安卓重生 AndroidReLive_ZPH —— 浏览器端的安卓设备重生控制台：实时投屏、文件传输、应用管理、ADB 终端",
  "keywords": [
    "android",
    "adb",
    "webadb",
    "scrcpy",
    "webusb",
    "screen-mirror",
    "remote-control"
  ],
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "node server.cjs",
    "bridge": "node bridge.mjs",
    "build": "esbuild src/relive/entry.js --bundle --format=esm --target=es2022 --legal-comments=none --external:@yume-chan/adb --external:@yume-chan/stream-extra --external:@yume-chan/struct --external:@yume-chan/event --external:@yume-chan/async --external:@yume-chan/no-data-view --outfile=js/vendor/relive.bundle.js",
    "watch": "esbuild src/relive/entry.js --bundle --format=esm --target=es2022 --legal-comments=none --external:@yume-chan/adb --external:@yume-chan/stream-extra --external:@yume-chan/struct --external:@yume-chan/event --external:@yume-chan/async --external:@yume-chan/no-data-view --outfile=js/vendor/relive.bundle.js --watch",
    "check": "node scripts/check-bundle-imports.cjs && node scripts/check-pages.cjs"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-tinyh264": "^2.1.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
